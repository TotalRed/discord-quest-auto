{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Auto",
  "version": "0.2.1",
  "identifier": "io.github.totalred.discordquestauto",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Discord Quest Auto",
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#111214",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
